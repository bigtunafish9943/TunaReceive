<resources>
    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Theme colours, Deep Sea by default; a chosen theme is laid over these -->
        <item name="tsNavy">#041431</item>
        <item name="tsDeep">#0A2350</item>
        <item name="tsSurface">#081A3A</item>
        <item name="tsSurfaceBorder">#142F58</item>
        <item name="tsAccent">#0CC8F6</item>
        <item name="tsAccentSoft">#8BE6FC</item>
        <item name="tsBlue">#0B74D1</item>
        <item name="tsText">#EEF5FB</item>
        <item name="tsTextSecondary">#9FB3CC</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Avoid some systems like MIUI which break the visibility of games title -->
        <item name="android:forceDarkAllowed">false</item>
        <!-- TunaStream colours (Material 3) -->
        <item name="colorPrimary">@color/ts_accent</item>
        <item name="colorOnPrimary">@color/ts_navy</item>
        <item name="colorPrimaryContainer">@color/ts_deep</item>
        <item name="colorOnPrimaryContainer">@color/ts_accent_soft</item>
        <item name="colorSecondary">@color/ts_accent_soft</item>
        <item name="colorOnSecondary">@color/ts_navy</item>
        <item name="colorSecondaryContainer">@color/ts_deep</item>
        <item name="colorOnSecondaryContainer">@color/ts_text</item>
        <item name="colorSurface">@color/ts_surface</item>
        <item name="colorOnSurface">@color/ts_text</item>
        <item name="colorSurfaceVariant">@color/ts_deep</item>
        <item name="colorOnSurfaceVariant">@color/ts_text_secondary</item>
        <item name="colorOutline">@color/ts_surface_border</item>
        <item name="android:colorBackground">@color/ts_navy</item>
        <item name="colorAccent">@color/ts_accent</item>
        <!-- Pop-ups: navy with light text, never light cyan -->
        <item name="android:alertDialogTheme">@style/TunaDialog</item>
        <item name="alertDialogTheme">@style/TunaDialogCompat</item>
        <item name="materialAlertDialogTheme">@style/TunaDialogCompat</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
    </style>
</resources>