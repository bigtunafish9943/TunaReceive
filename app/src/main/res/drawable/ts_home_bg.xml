<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: the theme's deep colour at the top fading to its darkest. Gradient colours
     must be theme attributes: a colour resource that refers to one shows as pink on Android 10+ -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="?attr/tsDeep"
        android:centerColor="?attr/tsNavy"
        android:endColor="?attr/tsNavy"
        android:type="linear" />
</shape>
