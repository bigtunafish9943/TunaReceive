<?xml version="1.0" encoding="utf-8"?>
<!-- Round header buttons: a cyan ring when the controller's cursor is on them -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/ts_deep" />
            <stroke android:width="2dp" android:color="@color/ts_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/ts_deep" />
            <stroke android:width="2dp" android:color="@color/ts_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ts_surface" />
            <stroke android:width="1dp" android:color="@color/ts_surface_border" />
        </shape>
    </item>
</selector>
