<?xml version="1.0" encoding="utf-8"?>
<!-- Highlight behind the PC or game under the controller's cursor -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#330CC8F6" />
            <stroke android:width="3dp" android:color="@color/ts_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#220CC8F6" />
            <stroke android:width="3dp" android:color="@color/ts_accent" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
