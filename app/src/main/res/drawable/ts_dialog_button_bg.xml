<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up buttons: a solid cyan pill on the selected one, so it is plain which is chosen -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/ts_accent" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/ts_accent" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="6dp" android:insetBottom="6dp">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="1dp" android:color="@color/ts_surface_border" />
                <corners android:radius="20dp" />
            </shape>
        </inset>
    </item>
</selector>
