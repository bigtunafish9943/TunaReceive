<?xml version="1.0" encoding="utf-8"?>
<!-- Pop-up boxes: dark navy card with a thin edge, like TunaStream's web page -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16dp" android:insetRight="16dp"
    android:insetTop="16dp" android:insetBottom="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/ts_surface" />
        <stroke android:width="1dp" android:color="@color/ts_surface_border" />
        <corners android:radius="16dp" />
    </shape>
</inset>
