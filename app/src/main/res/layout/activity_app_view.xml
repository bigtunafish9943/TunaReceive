<?xml version="1.0" encoding="utf-8"?>
<!-- A PC's games: TunaReceive's name and the PC tools across the top, the PC's name, the games below -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ts_home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AppView">

    <LinearLayout
        android:id="@+id/appHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:preferKeepClear="true">

        <include layout="@layout/ts_brand" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Everything to do with this PC in one place, and the settings, without leaving the games -->
        <Button
            android:id="@+id/pcToolsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:background="@drawable/ts_dialog_button_bg"
            android:textColor="@color/ts_dialog_button_text"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:text="@string/pc_tools_button" />

        <Button
            android:id="@+id/appSettingsButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:background="@drawable/ts_dialog_button_bg"
            android:textColor="@color/ts_dialog_button_text"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:text="@string/settings_button" />
    </LinearLayout>

    <!-- Which PC these games are on -->
    <LinearLayout
        android:id="@+id/appPcRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/appHeader"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:id="@+id/appListText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ts_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/apps_choose_game"
            android:textColor="@color/ts_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/appFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/appPcRow"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:contentDescription="@string/profile_manager_choose_profile"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>
