<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="220dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="@color/ts_surface"
        app:cardElevation="8dp"
        app:cardMaxElevation="8dp">

        <ImageView
            android:id="@+id/grid_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cropToPadding="false"
            android:scaleType="centerCrop" />

        <RelativeLayout
            android:id="@+id/grid_mask"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- "Continue" on the game played last, "Playing" on the one running -->
            <TextView
                android:id="@+id/grid_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true"
                android:layout_margin="8dp"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/ts_grid_badge_bg"
                android:textColor="#04121F"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="2dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="50dp" />

            <TextView
                android:id="@+id/grid_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/grid_overlay"
                android:layout_margin="5dp"
                android:gravity="center|center_vertical"
                android:background="#00FFFFFF"
                android:textAlignment="center"
                android:textColor="@color/ts_text"
                android:textStyle="bold"
                android:textSize="17sp" />
        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</RelativeLayout>