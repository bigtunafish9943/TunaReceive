<?xml version="1.0" encoding="utf-8"?>
<!-- TunaReceive's home screen: the TunaStream mark and name across the top, round buttons on the
     right, and the PCs below. Used in both orientations. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/ts_home_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PcView">

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/brandMark"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ts_mark"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_label"
                android:textColor="@color/ts_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_tagline"
                android:textColor="@color/ts_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/updateButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ts_icon_button_bg"
            android:src="@drawable/ic_update"
            android:contentDescription="@string/update_settings_title"
            android:preferKeepClear="true" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ts_icon_button_bg"
            android:src="@drawable/ic_help"
            android:contentDescription="@string/help"
            android:preferKeepClear="true" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ts_icon_button_bg"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/tuna_settings_button"
            android:preferKeepClear="true" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/ts_icon_button_bg"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/title_add_pc"
            android:preferKeepClear="true" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/homeHeader"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/activity_horizontal_margin"
            android:paddingEnd="@dimen/activity_horizontal_margin">
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ts_mark"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ProgressBar
                    android:id="@+id/pcs_loading"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:indeterminate="true" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/searching_pc"
                    android:textColor="@color/ts_text"
                    android:textSize="20sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="420dp"
                android:gravity="center"
                android:text="@string/home_searching_hint"
                android:textColor="@color/ts_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:contentDescription="@string/profile_manager_choose_profile"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>
